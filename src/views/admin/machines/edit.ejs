<%- include('../../partials/adminMainSection', { pageTitle: 'AR Vending | Admin Panel' , activePage: 'machines' ,
    subTitle: 'Edit machine' , error: typeof error !=='undefined' ? error : null }) %>

<% if (typeof data !== 'undefined' && typeof data?.machine !== 'undefined') { %>
    <script>
        window.data = "<%= JSON.stringify(data) %>";
    </script>

    <%
        const formatDate = (dateString) => {
            const d = new Date(dateString);
            return isNaN(d)
                ? ''
                : new Date(d.getTime() - d.getTimezoneOffset() * 60000)
                    .toISOString()
                    .split('T')[0];
        };
    %>

    <div class="py-6 px-4 sm:px-8 lg:px-14">
        <div class="rounded-3xl bg-white p-6 shadow-lg ring-1 ring-slate-200/70">
            <div class="flex flex-col gap-4 border-b border-slate-100 pb-5 md:flex-row md:items-center md:justify-between">
                <a href="/admin/back"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
            </div>

                <div class="mt-5 w-full">
                    <% if (typeof data?.types !== 'undefined') { %>
                        <label for="machine-type" class="text-sm font-semibold text-gray-600">Select Machine Type<span class="text-emerald-600"> *</span></label>
                        <select id="machine-type" class="mt-2 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-100">
                            <% data.types.forEach(type => { %>
                                <option value="<%= type.id %>" <%= data.machine.type_id === type.id ? 'selected' : '' %>><%= type.name %></option>
                            <% }) %>
                        </select>
                    <% } else { %> 
                        <p class="text-red-500">Failed to load machine types. Please refresh the page.</p>
                    <% } %>
                </div>
                
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2 mt-5">
                
                    <div class="flex flex-col relative">
                        <label for="company-name" class="text-sm font-semibold text-gray-600">Customer's Company Name <span class="text-emerald-600"> *</span></label>
                        <div class="flex justify-between items-center mt-2 rounded-lg border border-gray-200 px-3 py-2 text-sm shadow-sm cursor-pointer active:border-emerald-400" id="company-name-dropdown">
                            <span id="selected-company-name" class="text-gray-500"><%= data.machine['Company Name'] || 'Select a company' %></span>
                            <i class="fa-solid fa-angle-down text-gray-500"></i>
                        </div>
                        <span class="mt-1 hidden text-xs text-red-500" data-error-for="company-name">Customer's company name is required.</span>
                        <div class="absolute top-[110%] items-center pr-3 bg-white border border-gray-300 rounded-md shadow-lg p-3 w-full hidden"  id="company-suggestion-container">
                            <div>
                                <input type="text" id="company-name-search" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-100" placeholder="Search existing companies...">
                            </div>
                            <% if (typeof data?.customers !== 'undefined') { %>
                                <% if (data.customers.length === 0) { %>
                                    <p class="text-gray-500 mt-2 text-sm px-3">No customers found. Please add a customer first.</p>
                                <% } else { %>
                                    <div class="mt-2 max-h-48 overflow-y-auto" id="company-name-suggestions-list"  data-selected-customer-id="<%= data.machine.customer_id %>">   
                                    </div>
                                <% } %>
                            <% } else { %>
                                <p class="text-red-500">Failed to load customers. Please refresh the page.</p>
                            <% } %>
                        </div>
                    </div>

                    <div class="flex flex-col">
                        <label for="machine-id" class="text-sm font-semibold text-gray-600">Machine ID<span class="text-emerald-600"> *</span></label>
                        <input id="machine-id" name="machine_id" type="text" data-required="true" class="mt-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-100" placeholder="AR Vending" value="<%= data.machine['Machine ID'] %>">
                        <span class="mt-1 hidden text-xs text-red-500" data-error-for="machine-id">Machine id is required.</span>
                    </div>

                    <div class="flex flex-col">
                        <label for="machine-registration-date" class="text-sm font-semibold text-gray-600">Machine Registration Date</label>
                        <input id="machine-registration-date" name="machine_registration_date" type="date" data-required="false" class="mt-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-100" placeholder="Machine Registration Date" value="<%= formatDate(data.machine['Registered Date']) %>">
                        <span class="mt-1 text-xs text-gray-400">If left unset, the current date will be used.</span>
                    </div>

                    <div class="flex flex-col">
                        <label for="end-date" class="text-sm font-semibold text-gray-600">End Date</label>
                        <input id="end-date" name="end_date" type="date" data-required="false" class="mt-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-100" placeholder="End Date" value="<%= formatDate(data.machine['End Date']) %>">
                        <span class="mt-1 text-xs text-gray-400">If left unset, End Date will be set to one year from the registration date.</span>
                    </div>
                    
                    <div class="flex flex-col">
                        <label for="subscription-fees" class="text-sm font-semibold text-gray-600">Subscription Fees (MYR)<span class="text-emerald-600"> *</span></label>
                        <input id="subscription-fees" name="subscription_fees" type="number" step="0.01" min="0.00" data-required="true" class="mt-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-100" placeholder="0.00" value="<%= data.machine['Subscription Fees'].replace('RM ', '') %>">
                        <span class="mt-1 hidden text-xs text-red-500" data-error-for="subscription-fees">Enter a valid subscription fee.</span>
                    </div>
                    
                    <div class="flex flex-col">
                        <label for="machine-status" class="text-sm font-semibold text-gray-600">Status<span class="text-emerald-600"> *</span></label>
                        <select id="machine-status" class="mt-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-100">
                            <option value="active" <%= data.machine['Status'] === 'active' ? 'selected' : '' %>>Active</option>
                            <option value="inactive" <%= data.machine['Status'] === 'inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                        <span class="mt-1 text-xs text-gray-400">If end date is in the past, status will be set to inactive.</span>
                        <span class="mt-1 hidden text-xs text-red-500" data-error-for="machine-status"></span>
                    </div>
                </div>

                <div id="additional-fields-container" class="mt-5 w-full border-t border-gray-200 pt-5">
                    <div id="additional-fields-list" class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    </div>
                </div>

                <div class="mt-8 flex flex-col gap-3 md:flex-row md:items-center md:justify-end">
                    <a href="/admin/machines/<%= data.machine.id %>" class="inline-flex items-center justify-center rounded-full border border-gray-200 px-5 py-2 text-sm font-semibold text-gray-500 hover:border-gray-300 hover:text-gray-700">Cancel</a>
                    <button id="save-machine-submit" type="button" class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-6 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600">Save Changes</button>
                </div>
        </div>
    </div>
<% } else { %>
    <div class="py-4 px-14">
        <div class="rounded-3xl bg-white p-6 shadow-lg ring-1 ring-slate-200/70">
            <div class="mt-5 rounded-2xl border border-red-100 bg-red-50 px-5 py-4 text-sm font-medium text-red-600 shadow-sm">
                Failed to load machine details. Please refresh the page.
            </div>
        </div>
    </div>
<% } %>
<%- include('../../partials/adminFooter', { scripts: ['/js/adminEditMachine.js'] }) %>