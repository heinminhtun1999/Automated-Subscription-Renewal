<%- include('../../partials/adminMainSection', { pageTitle: 'AR Vending | Admin Panel', activePage: 'machines', subTitle: 'Manage Machine Types', error: typeof error !== 'undefined' ? error : null }) %>
<div class="py-6 px-4 sm:px-8 lg:px-14 space-y-6">

    <section class="rounded-3xl bg-white p-6 shadow-lg ring-1 ring-slate-200/70">
        <div class="flex justify-between gap-3 border-b border-slate-100 pb-4">
            <a href="/admin/back"
            class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <button class="inline-flex items-center gap-2 rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600" onclick="openAddTypeModal()">
                <i class="fa-solid fa-plus mr-2"></i>Add type
            </button>
        </div>
        <div class="overflow-hidden">
            <div class="overflow-x-auto">
            <table id="machinesTypesTable" class="display nowrap !-z-1 border-collapse w-full">
            <thead>
                    <tr class="text-left">
                        <th>No.</th>
                        <th>Machine Type</th>
                        <th>Fields</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof data !== 'undefined') { %>
                        <% data.forEach((type, i) => { %>
                            <tr class="text-left relative">
                                <td><%= i + 1 %></td>
                                <td><%= type.name %></td>
                                <td><%= type.fields.map(field => field.name).join(", ") %></td>
                                <td>
                                    <button class="text-emerald-500 hover:text-emerald-600 font-bold py-2 px-4 rounded"
                                        onclick='manageFields(this)'
                                        data-typedata="<%= JSON.stringify({ typeId: type.type_id, typeName: type.name, fields: type.fields }) %>">
                                        <i class="fa-solid fa-gear fa-sm"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center py-4">No data found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>
</div>

<div id="type-modal" class="fixed inset-0 z-40 hidden">
    <div data-type-modal-overlay class="absolute inset-0 bg-black/40"></div>
    <div class="relative mx-auto my-4 flex h-[calc(100vh-2rem)] w-[92%] max-w-3xl flex-col overflow-hidden rounded-xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
            <div>
                <p class="text-xs font-semibold uppercase text-slate-400">Machine Types</p>
                <h2 class="text-xl font-bold text-slate-700">Add Machine Type</h2>
            </div>
        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-6 py-5">
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm font-semibold text-slate-600">Type Details</p>
                <div class="mt-3">
                    <label class="mb-2 block text-sm font-medium text-slate-600" for="type-name-input">Type name</label>
                    <input id="type-name-input" data-type-name type="text" placeholder="Enter type name" class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none">
                </div>
                <p data-type-error class="mt-2 hidden text-xs font-semibold text-red-500"></p>
            </div>

            <div class="mt-5 rounded-lg border border-slate-200 bg-white p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="text-sm font-semibold text-slate-600">Fields</p>
                        <p class="text-xs text-slate-400">Add as many field names as needed for this new type.</p>
                    </div>
                    <button data-add-type-field class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
                        <i class="fa-solid fa-plus mr-2"></i>Add New Field
                    </button>
                </div>

                <div class="mt-4 grid grid-cols-[1fr_auto] gap-3 text-xs font-semibold uppercase text-slate-400">
                    <span>Field Name</span>
                    <span>Action</span>
                </div>

                <div data-type-fields-list class="mt-3 space-y-2"></div>

                <p data-type-empty-state class="mt-4 text-sm text-slate-500">No fields added yet. Click Add New Field to start.</p>
            </div>
        </div>

        <div class="shrink-0 flex items-center justify-between border-t border-slate-200 px-6 py-4">
            <div class="flex gap-3 ml-auto">
                <button data-type-modal-close class="rounded-md bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-200">Close</button>
                <button data-save-type class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Save Type</button>
            </div>
        </div>
    </div>
</div>

<div id="fields-modal" class="fixed inset-0 z-40 hidden">
    <div data-modal-overlay class="absolute inset-0 bg-black/40"></div>
    <div class="relative mx-auto my-4 flex h-[calc(100vh-2rem)] w-[92%] max-w-3xl flex-col overflow-hidden rounded-xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
            <div>
                <p class="text-xs font-semibold uppercase text-slate-400">Machine Types</p>
                <h2 class="text-xl font-bold text-slate-700" data-modal-title>Manage Type</h2>
            </div>
        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-6 py-5">
            <div class="mb-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm font-semibold text-slate-600">Type Details</p>
                <div class="mt-3">
                    <label class="mb-2 block text-sm font-medium text-slate-600" for="manage-type-name-input">Type name</label>
                    <input id="manage-type-name-input" data-manage-type-name type="text" placeholder="Enter machine type name" class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none">
                </div>
            </div>

            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm font-semibold text-slate-600">Add New Field</p>
                <div class="mt-3 grid gap-3 md:grid-cols-[1.2fr_auto]">
                    <input data-new-name type="text" placeholder="Field name" class="w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none">
                    <button data-add-field class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Add</button>
                </div>
                <p data-new-error class="mt-2 hidden text-xs font-semibold text-red-500"></p>
            </div>

            <div class="mt-5">
                <div class="grid grid-cols-[1.2fr_auto] gap-3 text-xs font-semibold uppercase text-slate-400">
                    <span>Name</span>
                    <span class="mr-3">Action</span>
                </div>
                <div data-fields-list class="mt-3 space-y-2"></div>
                <p data-empty-state class="mt-4 hidden text-sm text-slate-500">No fields yet. Add the first one above.</p>
            </div>

            <div data-delete-modal class="fixed inset-0 z-50 hidden items-center justify-center px-4">
                <div data-delete-overlay class="absolute inset-0 bg-black/40"></div>
                <div class="relative z-10 w-full max-w-md rounded-lg border border-rose-200 bg-rose-50 p-4 shadow-lg">
                    <p class="text-sm font-semibold text-rose-700">Delete field?</p>
                    <p class="mt-1 text-sm text-rose-700">
                        This action cannot be undone. Field data cannot be recovered.
                    </p>

                    <div class="mt-3 flex flex-wrap gap-3">
                        <button data-confirm-delete class="rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-700">
                            Confirm Delete
                        </button>
                        <button data-cancel-delete class="rounded-md bg-white px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="shrink-0 flex items-center justify-between border-t border-slate-200 px-6 py-4">
            <div data-delete-type-modal class="fixed inset-0 z-50 hidden items-center justify-center px-4">
                <div data-delete-type-overlay class="absolute inset-0 bg-black/40"></div>
                <div class="relative z-10 w-full max-w-md rounded-lg border border-rose-200 bg-rose-50 p-4 shadow-lg">
                    <p class="text-sm font-semibold text-rose-700" data-delete-type-name>Delete type?</p>
                    <p class="mt-1 text-sm text-rose-700">
                        This action cannot be undone. All the machines of this type and related data will be deleted, and cannot be recovered.
                    </p>

                    <div class="mt-3 flex flex-wrap gap-3">
                        <button data-confirm-delete-type class="rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-700">
                            Confirm Delete
                        </button>
                        <button data-cancel-delete-type class="rounded-md bg-white px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
            
            <div>
                <button data-delete-type class="rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                    <i class="fa-solid fa-trash"></i> Delete Type
                </button>
            </div>
            <div class="flex gap-3 ml-auto">
                <button data-modal-close class="rounded-md bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-200">Close</button>
                <button data-save-fields class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Save Changes</button>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/adminFooter', { scripts: ['/js/adminMachineTypes.js'] }) %>