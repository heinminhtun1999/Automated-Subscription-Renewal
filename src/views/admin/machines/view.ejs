<%- include('../../partials/adminMainSection', { pageTitle: 'AR Vending | Admin Panel' , activePage: 'machines' ,
subTitle: 'Machine Details' , error: typeof error !=='undefined' ? error : null }) %>
<div class="py-6 px-4 sm:px-8 lg:px-14">
    <div class="rounded-3xl bg-white p-6 shadow-lg ring-1 ring-slate-200/70">
        <!-- <a href="/admin/machines?selected_machine_type=<%= data.type_id ;%>" -->
        <div class="flex flex-col gap-4 border-b border-slate-100 pb-5 md:flex-row md:items-center md:justify-between">
            <a href="/admin/back"
               class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>


        <div class="mt-6">
            <% if (typeof data !== 'undefined' && data) { %>
                <div id="delete-confirm-modal" class="fixed inset-0 z-40 hidden">
                    <div data-type-modal-overlay class="absolute inset-0 w-full h-full bg-black/40"></div>
                    <div>
                        <div class="absolute top-1/2 left-1/2 w-full max-w-sm -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-5 shadow-lg ring-1 ring-slate-200">
                            <h3 class="text-lg font-semibold text-gray-800">Confirm Deletion</h3>
                            <p class="mt-2 text-sm text-gray-600">Are you sure you want to delete this machine? This
                                action cannot be undone.</p>
                            <div class="mt-5 flex justify-end gap-3">
                                <button id="cancel-delete-btn"
                                        class="px-4 py-2 text-sm font-semibold text-gray-600 hover:text-gray-800">Cancel
                                </button>
                                <form data-machine-id="<%= data.id ;%>" style="display: inline;"
                                      id="confirm-delete-form">
                                    <button type="submit"
                                            class="px-4 py-2 text-sm font-semibold text-red-600 hover:text-red-700">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="manual-renewed-modal" class="fixed inset-0 z-40 hidden" aria-hidden="true">
                    <div data-manual-renewed-modal-overlay class="absolute inset-0 w-full h-full bg-black/40"></div>
                    <div>
                        <div class="absolute top-1/2 left-1/2 w-full max-w-2xl -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-white p-5 shadow-lg ring-1 ring-slate-200 sm:p-6">
                            <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
                                <h3 class="text-lg font-semibold text-gray-800">Add Manual Renewed Record</h3>
                                <button
                                        id="close-manual-renewed-modal-btn"
                                        type="button"
                                        class="inline-flex h-8 w-8 items-center justify-center rounded-full text-gray-500 transition hover:bg-slate-100 hover:text-gray-700"
                                        aria-label="Close add manual renewed record modal"
                                >
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>

                            <form id="manual-renewed-form" class="mt-5" method="POST" action="#">
                                <input type="hidden" name="machine_id" id="form-machine-id" value="<%= data.id ;%>">

                                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                    <div>
                                        <label for="paid-date"
                                               class="block text-xs font-bold uppercase tracking-[0.18em] text-gray-500">Paid
                                            Date <span class="text-red-500">*</span></label>
                                        <input
                                                id="paid-date"
                                                name="paid_date"
                                                type="datetime-local"
                                                class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-gray-800 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
                                        >
                                        <span id="date-error-label" class="text-red-500 text-xs ml-1 hidden">Paid Date is required.</span>
                                    </div>

                                    <div>
                                        <label for="renewed-amount"
                                               class="block text-xs font-bold uppercase tracking-[0.18em] text-gray-500">Amount
                                            <span class="text-red-500">*</span></label>
                                        <input
                                                id="renewed-amount"
                                                name="amount"
                                                type="number"
                                                min="0"
                                                step="0.01"
                                                value="<%= Number(data['Subscription Fees'].split(' ')[1] || 0).toFixed(2) ;%>"
                                                class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-gray-800 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
                                        >
                                        <span id="amount-error-label" class="text-red-500 text-xs ml-1 hidden">Amount is required.</span>
                                    </div>

                                    <div>
                                        <label for="payment-method"
                                               class="block text-xs font-bold uppercase tracking-[0.18em] text-gray-500">Payment
                                            Method</label>
                                        <input
                                                id="payment-method"
                                                name="payment_method"
                                                type="text"
                                                placeholder="e.g. Bank Transfer"
                                                class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-gray-800 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
                                        >
                                    </div>

                                    <div>
                                        <label for="extend-by-years"
                                               class="block text-xs font-bold uppercase tracking-[0.18em] text-gray-500">Extend
                                            By (Years)</label>
                                        <input
                                                id="extend-by-years"
                                                name="extend_by_years"
                                                type="number"
                                                min="1"
                                                step="1"
                                                value="<%= data['Subscription Period (Year)'] ;%>"
                                                class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-gray-800 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
                                        >
                                        <span id="period-error-label" class="text-red-500 text-xs ml-1 hidden">Value must be larger than 0.</span>
                                    </div>
                                </div>

                                <div class="mt-6 flex justify-end gap-3">
                                    <button
                                            id="cancel-manual-renewed-modal-btn"
                                            type="button"
                                            class="rounded-lg px-4 py-2 text-sm font-semibold text-gray-600 transition hover:text-gray-800"
                                    >
                                        Close
                                    </button>
                                    <button
                                            type="submit"
                                            class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
                                    >
                                        Save Record
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="w-full h-full">
                    <div class="flex justify-between items-center">
                        <h2 class="text-lg font-semibold text-gray-800">Machine Details</h2>
                        <div class="flex gap-4">
                            <a href="/admin/machines/<%= data.id ;%>/edit"
                               class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700"
                               id="edit-machine-btn">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </a>
                            <button id="delete-machine-btn"
                                    class="inline-flex items-center gap-2 text-sm font-semibold text-red-600 hover:text-red-700">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                    <div class="mt-5">
                        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                            <% for (const [ key, value ] of Object.entries(data)) { %>
                                <% if (key !== 'id' && key !== 'type_id' && key !== 'customer_id') { %>
                                    <div class="rounded-2xl border border-slate-200/70 bg-slate-50 px-5 py-4 transition-colors hover:border-emerald-200 hover:bg-emerald-50/40">

                                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-gray-500"><%= key ;%></p>

                                        <% if (key.toLowerCase() === 'company name') { %>
                                            <a href="/admin/customers/<%= data.customer_id ;%>"
                                               class="mt-2 block break-words text-sm text-emerald-600 underline decoration-emerald-300 decoration-2 underline-offset-2"><%= value ?? '-' ;%></a>
                                        <% } else if (key.toLowerCase() === 'allow renewal after subscription expiration') { %>
                                            <p class="mt-2 break-words text-sm text-gray-800"><%= value == 0 ? 'Not Allowed' : 'Allowed' ;%></p>
                                        <% } else { %>
                                            <p class="mt-2 break-words text-sm <%= key.toLowerCase() == 'status' ? (value == 'active' ? 'text-emerald-600' : 'text-red-500') : '' ;%>"><%= value ?? '-' ;%></p>
                                        <% } %>
                                    </div>
                                <% } %>
                            <% } %>
                        </div>
                    </div>
                    <div class="my-8 overflow-hidden rounded-2xl border border-emerald-200 bg-gradient-to-br from-gray-50/20 via-gray-50 to-emerald-50/70 shadow-sm">
                        <div class="flex flex-col gap-5 p-5 md:flex-row md:items-center md:justify-between">

                            <div class="flex items-start gap-4">
                                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">

                                    <i class="fa-solid fa-arrow-rotate-right text-xl"></i>
                                </div>

                                <div>
                                    <h3 class="text-base font-bold text-gray-800">
                                        Renewed Manually?
                                    </h3>

                                    <p class="mt-1 max-w-xl text-sm leading-relaxed text-gray-600">
                                        If the customer renewed the machine's subscription externally, you may add the
                                        record here. The record will appear in Orders table.
                                        After adding the record, the machine's end date will be extended automatically.
                                    </p>
                                </div>
                            </div>
                            <button
                                    id="manual-renewed-btn"
                                    class="
                                        rounded-xl
                                        bg-gradient-to-r from-emerald-700 to-emerald-500
                                        px-6 py-3
                                        text-sm font-semibold text-white
                                        shadow-md shadow-emerald-700/30
                                        transition-all duration-200
                                        hover:-translate-y-0.5
                                        hover:shadow-lg hover:shadow-emerald-700/40
                                        active:translate-y-0
                                    "
                                    data-machine-id="<%= data.id ;%>"
                                    data-default-amount="<%= Number(data.subscription_fees || 0).toFixed(2) ;%>"
                            >
                                <div class="inline-flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-plus"></i>
                                    Add Record
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="mt-5 rounded-lg border border-red-100 bg-red-50 px-5 py-4 text-sm font-medium text-red-600 shadow-sm">
                    Failed to load machine details. Please refresh the page.
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../../partials/adminFooter', { scripts: ['/js/adminViewMachine.js'] }) %>