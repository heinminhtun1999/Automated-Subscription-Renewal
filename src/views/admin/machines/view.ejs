<%- include('../../partials/adminMainSection', { pageTitle: 'AR Vending | Admin Panel' , activePage: 'machines' ,
    subTitle: 'Machine Details' , error: typeof error !=='undefined' ? error : null }) %>
<div class="py-4 px-14">
    <div class="w-full h-full p-5 bg-white rounded-lg shadow-lg">
        <!-- <a href="/admin/machines?selected_machine_type=<%= data.type_id %>" -->
        <a href="/admin/back"
            class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700">
            <i class="fa-solid fa-arrow-left"></i> Back 
        </a>


        <div class="mt-5">
            <% if (typeof data !== 'undefined' && data) { %>
                <div id="delete-confirm-modal" class="fixed inset-0 z-40 hidden">
                    <div data-type-modal-overlay class="absolute inset-0 w-full h-full bg-black/40"></div>
                    <div>
                        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-5 shadow-lg w-full max-w-sm">
                            <h3 class="text-lg font-semibold text-gray-800">Confirm Deletion</h3>
                            <p class="mt-2 text-sm text-gray-600">Are you sure you want to delete this machine? This action cannot be undone.</p>
                            <div class="mt-5 flex justify-end gap-3">
                                <button id="cancel-delete-btn" class="px-4 py-2 text-sm font-semibold text-gray-600 hover:text-gray-800">Cancel</button>
                                <form data-machine-id="<%= data.id %>" style="display: inline;" id="confirm-delete-form">
                                    <button type="submit" class="px-4 py-2 text-sm font-semibold text-red-600 hover:text-red-700">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="w-full h-full">
                    <div class="flex justify-between items-center">
                        <h2 class="text-lg font-semibold text-gray-800">Machine Details</h2>
                        <div class="flex gap-4">
                            <a href="/admin/machines/<%= data.id %>/edit" class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700" id="edit-machine-btn">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </a>
                            <button id="delete-machine-btn" class="inline-flex items-center gap-2 text-sm font-semibold text-red-600 hover:text-red-700">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                    <div class="mt-5">
                        <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                            <% for (const [key, value] of Object.entries(data)) { %>
                                <% if (key !== 'id' && key !== 'type_id' && key !== 'company_id') { %>
                                    <div class="rounded-md bg-gray-50 px-5 py-4 hover:bg-gray-100 transition-colors border border-gray-200">
                                        <p class="text-xs font-bold text-gray-500"><%= key %></p>
                                        <% if (key.toLowerCase() === 'company name') { %>
                                            <a href="/admin/customers/<%= data.company_id %>" class="mt-1 break-words text-sm text-gray-800 underline"><%= value || '-' %></a>
                                        <% } else { %>
                                            <p class="mt-1 break-words text-sm text-gray-800 <%= key.toLowerCase() == 'status' ? value == 'active' ? 'text-emerald-400' : 'text-red-400' : '' %>"><%= value || '-' %></p>
                                        <% } %>
                                    </div>
                                <% } %>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="mt-5 rounded-lg border border-red-100 bg-red-50 px-5 py-4 text-sm font-medium text-red-600 shadow-sm">
                    Failed to load machine details. Please refresh the page.
                </div>
            <% } %>
        </div>
    </div>
</div>
        
<%- include('../../partials/adminFooter', { scripts: ['/js/adminViewMachine.js'] }) %>