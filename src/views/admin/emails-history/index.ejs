<%- include('../../partials/adminMainSection', { pageTitle: 'AR Vending | Admin Panel', activePage: 'emails-history', error: typeof error !== 'undefined' ? error : null, subTitle: 'Email History' }) %>
<div class="py-4 px-14">
    <div class="w-full h-full p-5 bg-white rounded-lg shadow-lg">
        <div class="overflow-x-auto">
            <table id="emailHistoryTable" class="display nowrap !-z-1">
            <thead>
                <tr>
                    <th>Email ID</th>
                    <th>Date/Time</th>
                    <th>Recipient</th>
                    <th>Recipient Email</th>
                    <th>Status</th>
                    <th>Email Failed Reasons</th>
                    <th>Renewed Machines</th>
                    <th>Renewal Pending Machines</th>
                    <th class="no-export">Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof data !== 'undefined') { %>
                    <% data.forEach((email, i) => { %>
                        <tr data-row-id="<%= email.id %>" data-email-data="<%= JSON.stringify(email) %>">
                            <td><%= email.id %></td>
                            <td><%= email.sent_date %></td>
                            <td title="<%= email.company_name %>" id="company_name">
                                <a href="/admin/customers/<%= email.customer_id %>" target="_blank" class="underline"><%= email.company_name %></a>
                            </td>
                            <td><%= email.recipient_email %></td>
                            <td class="<%= email.status === 'sent' ? '!text-green-500' : email.status === 'pending' ? '!text-yellow-500' : '!text-red-500' %>"><%= email.status %></td>
                            <td><%= email.failed_reason %></td>
                            <td><%= email.machines.renewed.map(machine => machine.machine_id).join(', ') %></td>
                            <td><%= email.machines.pendingRenewal.map(machine => machine.machine_id).join(', ') %></td>
                            <td>
                                <button class="bg-emerald-500 hover:bg-emerald-600 text-white py-2 px-4 rounded" onclick="openEmailHistoryDetailsModal('<%= JSON.stringify(email) %>')">View Details</button>
                            </td>
                        </tr>
                   <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="11" class="text-center py-4">No email found.</td>
                    </tr>
                <% } %>
            </tbody> 
            </table>
        </div>
    </div>
</div>
<%- include('../../partials/adminFooter', { scripts: ['/js/adminEmailHistory.js']}) %>
