<%- include('../../partials/adminMainSection', { pageTitle: 'AR Vending | Admin Panel', activePage: 'orders', error: typeof error !== 'undefined' ? error : null, subTitle: 'Orders' }) %>
<div class="py-4 px-14">
    <div class="w-full h-full p-5 bg-white rounded-lg shadow-lg">
        <div class="overflow-x-auto">
            <table id="orderTable" class="display nowrap !-z-1">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Date/Time</th>
                    <th>Order ID</th>
                    <th>Transaction ID</th>
                    <th>Amount</th>
                    <th>Payment Status</th>
                    <th>Fulfillment Status</th>
                    <th>Error Remarks</th>
                    <th>Paid On</th>
                    <th>Channel</th>
                    <th>Customer</th>
                    <th>Machines</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof data !== 'undefined') { %>
                    <% data.forEach((order, i) => { %>
                        <tr data-row-id="<%= order.id %>">
                            <td><%= i + 1 %></td>
                            <td><%= order.created_at %></td>
                            <td><%= order.order_id %></td>
                            <td><%= order.transaction_id %></td>
                            <td>RM <%= order.amount.toFixed(2) %></td>
                            <td><%= order.payment_status %></td>
                            <td><%= order.process_status %></td>
                            <td><%= order.failed_remark %></td>
                            <td><%= order.paid_on %></td>
                            <td><%= order.channel %></td>
                            <td title="<%= order.company_name %>">
                                <a href="/admin/customers/<%= order.customer_id %>" target="_blank" class="underline"><%= order.company_name %></a>
                            </td>
                            <td><%= order.machines.join(", ") %></td>
                        </tr>
                   <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="11" class="text-center py-4">No orders found.</td>
                    </tr>
                <% } %>
            </tbody> 
            </table>
        </div>
    </div>
</div>
<%- include('../../partials/adminFooter', { scripts: ['/js/adminOrders.js'] }) %>
