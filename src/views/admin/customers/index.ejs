<%- include('../../partials/adminMainSection', { pageTitle: 'AR Vending | Admin Panel', activePage: 'customers', subTitle: 'Customers', error: typeof error !== 'undefined' ? error : null }) %>
<div class="py-4 px-14">
    <div class="w-full h-full p-5 bg-white rounded-lg shadow-lg">
        <div class="flex justify-between mb-6 ">
            <a href="/admin/customers/add" class=" ml-auto px-3 py-1 text-white bg-emerald-400 rounded hover:bg-emerald-500 transition-colors duration-200 text-sm font-semibold">
                <i class="fa-solid fa-plus fa-sm"></i> Add
            </a>
        </div>
        <div class="overflow-x-auto">
            <table id="customerTable" class="display nowrap !-z-1">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Company Name</th>
                    <th>Company Short Name</th>
                    <th>PIC Name</th>
                    <th>Email</th>
                    <th>Contact Number</th>
                    <th>Bank Name</th>
                    <th>Bank Account Number</th>
                    <th>Beneficiary Name</th>
                    <th class="no-export">Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof data !== 'undefined') { %>
                    <% data.forEach((customer, i) => { %>
                        <tr data-row-id="<%= customer.id %>">
                            <td><%= i + 1 %></td>
                            <td><%= customer.company_name %></td>
                            <td><%= customer.company_short_name %></td>
                            <td><%= customer.pic_name %></td>
                            <td><%= customer.email %></td>
                            <td><%= customer.contact_number %></td>
                            <td><%= customer.bank_name %></td>
                            <td><%= customer.bank_account_number %></td>
                            <td><%= customer.beneficiary_name %></td>
                            <td>
                                <a href="/admin/customers/<%= customer.id %>" class="text-emerald-500 hover:text-emerald-600 font-bold py-2 px-4 rounded">
                                    <i class="fa-solid fa-eye fa-sm"></i> View
                                </a>                                
                                <a href="/admin/customers/<%= customer.id %>/edit" class="text-emerald-500 hover:text-emerald-600 font-bold py-2 px-4 rounded">
                                    <i class="fa-solid fa-edit fa-sm"></i> Edit
                                </a>                                
                            </td>
                        </tr>
                   <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="11" class="text-center py-4">No customers found.</td>
                    </tr>
                <% } %>
            </tbody> 
            </table>
        </div>
    </div>
</div>
<%- include('../../partials/adminFooter', { scripts: ['/js/admincustomers.js'] }) %>
