<%- include('../../partials/adminMainSection', { pageTitle: 'AR Vending | Admin Panel', activePage: 'customers', subTitle: 'Customers', error: typeof error !== 'undefined' ? error : null }) %>
<%
    const customers = Array.isArray(data) ? data : [];
%>
<div class="py-6 px-4 sm:px-8 lg:px-14 space-y-6">

    <section class="rounded-3xl bg-white p-6 shadow-lg ring-1 ring-slate-200/70">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
            <a href="/admin/customers/add" class="inline-flex items-center gap-2 rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600">
                <i class="fa-solid fa-plus fa-sm"></i> Add
            </a>
        </div>

        <div class="mt-4 overflow-hidden">
            <div class="overflow-x-auto">
                <table id="customerTable" class="display nowrap !-z-1 min-w-full">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Company Name</th>
                        <th>Company Short Name</th>
                        <th>PIC Name</th>
                        <th>Email</th>
                        <th>Contact Number</th>
                        <th>Bank Name</th>
                        <th>Bank Account Number</th>
                        <th>Beneficiary Name</th>
                        <th class="no-export">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (customers.length) { %>
                        <% customers.forEach((customer, i) => { %>
                            <tr data-row-id="<%= customer.id %>">
                                <td><%= i + 1 %></td>
                                <td><%= customer.company_name %></td>
                                <td><%= customer.company_short_name %></td>
                                <td><%= customer.pic_name %></td>
                                <td><%= customer.email %></td>
                                <td><%= customer.contact_number %></td>
                                <td><%= customer.bank_name %></td>
                                <td><%= customer.bank_account_number %></td>
                                <td><%= customer.beneficiary_name %></td>
                                <td>
                                    <a href="/admin/customers/<%= customer.id %>" class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 font-semibold text-emerald-600 hover:bg-emerald-50">
                                        <i class="fa-solid fa-eye fa-sm"></i> View
                                    </a>
                                    <a href="/admin/customers/<%= customer.id %>/edit" class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 font-semibold text-emerald-600 hover:bg-emerald-50">
                                        <i class="fa-solid fa-edit fa-sm"></i> Edit
                                    </a>
                                </td>
                            </tr>
                       <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="11" class="py-8 text-center text-sm text-gray-500">No customers found.</td>
                        </tr>
                    <% } %>
                </tbody> 
                </table>
            </div>
        </div>
    </section>
</div>
<%- include('../../partials/adminFooter', { scripts: ['/js/admincustomers.js'] }) %>
