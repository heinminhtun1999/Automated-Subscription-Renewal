<%- include('../../partials/adminMainSection', { pageTitle: 'AR Vending | Admin Panel' , activePage: 'customers' ,
    subTitle: 'Customer Details' , error: typeof error !=='undefined' ? error : null }) %>
    
    <% 
        function convertTitleCase(str) {
            return str.split("_").join(" ").split(" ").map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(" ");
        }
    %>
    
    <div class="py-4 px-14">
        <div class="w-full h-full p-5 bg-white rounded-lg shadow-lg">
            <a href="/admin/back"
            class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <div class="mt-5">
                <% if (typeof data !== 'undefined' && data) { %>
                    <div id="delete-confirm-modal" class="fixed inset-0 z-40 hidden">
                        <div data-type-modal-overlay class="absolute inset-0 w-full h-full bg-black/40"></div>
                        <div>
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-5 shadow-lg w-full max-w-sm">
                                <h3 class="text-lg font-semibold text-gray-800">Confirm Deletion</h3>
                                <p class="mt-2 text-sm text-gray-600">Are you sure you want to delete this customer? This action cannot be undone.</p>
                                <div class="mt-5 flex justify-end gap-3">
                                    <button id="cancel-delete-btn" class="px-4 py-2 text-sm font-semibold text-gray-600 hover:text-gray-800">Cancel</button>
                                    <form data-customer-id="<%= data.id %>" style="display: inline;" id="confirm-delete-form">
                                        <button type="submit" class="px-4 py-2 text-sm font-semibold text-red-600 hover:text-red-700">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="w-full h-full">
                        <div class="flex justify-between items-center">
                            <h2 class="text-lg font-semibold text-gray-800">Customer Details</h2>
                            <div class="flex gap-4">
                                <a href="/admin/customers/<%= data.id %>/edit" class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700" id="edit-customer-btn">
                                    <i class="fa-solid fa-pen-to-square"></i> Edit
                                </a>
                                <button id="delete-customer-btn" class="inline-flex items-center gap-2 text-sm font-semibold text-red-600 hover:text-red-700">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                        <div class="mt-5">
                            <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                                <% for (const [key, value] of Object.entries(data)) { %>
                                    <% if (key.toLowerCase() !== 'id' && key.toLowerCase() !== 'machines') { %>
                                        <div class="my-2">
                                            <p class="text-sm font-bold text-gray-500"><%= convertTitleCase(key) %></p>
                                            <p data-edit data-field="<%= key %>" class="mt-1 break-words text-sm text-gray-800"><%= value || '-' %></p>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                        <div>
                            <h3 class="mt-8 text-md font-semibold text-gray-800">Machines</h3>
                            <div class="mt-3 overflow-x-auto">
                                <table id="customer-machines-table" class="min-w-full divide-y divide-gray-200 rounded-lg border border-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">No.</th>
                                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Machine ID</th>
                                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Machine Type</th>
                                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">End Date</th>
                                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Status</th>
                                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 bg-white">
                                        <% const machines = Array.isArray(data.machines) ? data.machines.filter(machine => machine && machine.id) : []; %>
                                        <% if (machines.length > 0) { %>
                                            <% machines.forEach((machine, i) => { %>
                                                <tr data-machine-row data-machine-id="<%= machine.id %>" class="cursor-pointer hover:bg-emerald-50/60 transition-colors duration-150">
                                                    <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= i + 1 %></td>
                                                    <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= machine.machine_id || '-' %></td>
                                                    <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= machine.machine_type || '-' %></td>
                                                    <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= machine.end_date || '-' %></td>
                                                    <td class="whitespace-nowrap px-4 py-3 text-sm font-medium <%= machine.status === 'active' ? 'text-emerald-600' : 'text-red-500' %>">
                                                        <%= machine.status || '-' %>
                                                    </td>
                                                    <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700">
                                                        <a href="/admin/machines/<%= machine.id %>" class="inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 hover:text-emerald-700">
                                                            <i class="fa-solid fa-eye"></i> View
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="px-4 py-4 text-center text-sm text-gray-500">No machines found for this customer.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="mt-5 rounded-lg border border-red-100 bg-red-50 px-5 py-4 text-sm font-medium text-red-600 shadow-sm">
                        Failed to load customer details. Please refresh the page.
                    </div>
                <% } %>
            </div>
        </div>
    </div>

<%- include('../../partials/adminFooter', { scripts: ['/js/adminViewCustomer.js'] }) %>