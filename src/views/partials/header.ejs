<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="icon" href="/images/ARV NEW LOGO.png">
    <link href="/css/style.css" rel="stylesheet">
    <% if (cssFile) { %>
        <link rel="stylesheet" href="<%= cssFile %>">
    <% } %>
    <% if (headContent) { %>
        <%- headContent %>
    <% } %>
</head>

<body>
