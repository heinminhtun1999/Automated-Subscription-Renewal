<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AR Vending | Payment Status</title>
    <link rel="stylesheet" href="/css/return.css">
</head>
<body>
    <div class="wrapper">
        <!-- Header Section -->
        <div class="header">
            <div class="header-content">
                <img src="/images/ARV NEW LOGO.png" alt="AR Vending Logo" class="logo">
                <div class="header-text">
                    <h1 class="company-name">AR Vending</h1>
                    <p class="subtitle">Subscription Renewal Management</p>
                </div>
            </div>
        </div>

        <div class="container">
            <!-- Status Card -->
            <div class="status-card success">
                <!-- Change "success" class to "failed" to show failure state -->
                <div class="icon">✓</div>

                <h1>Payment Successful</h1>
                <p class="status-message">Your payment has been processed successfully.
                    Thank you for your purchase.</p>

                <div class="details">
                    <div class="detail-row">
                        <span class="detail-label">Order ID</span>
                        <strong class="detail-value">#ORD-10293</strong>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Amount Paid</span>
                        <strong class="detail-value">RM 25.00</strong>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Status</span>
                        <strong class="detail-value">Completed</strong>
                    </div>
                </div>

                <div class="actions">
                    <button class="btn btn-secondary" onclick="window.location.href='/support'">Contact Support</button>
                </div>
            </div>

            <!-- Contact Section -->
            <div class="contact-section">
                <h4 class="contact-title">Need Help?</h4>
                <p class="contact-text">If any error occurs or you need assistance, please contact us:</p>
                <div class="contact-info">
                    <div class="contact-item">
                        <span class="contact-icon">📧</span>
                        <a href="mailto:support@arvending.com">support@arvending.com</a>
                    </div>
                    <div class="contact-item">
                        <span class="contact-icon">📞</span>
                        <a href="tel:+60123456789">+60 (123) 456-789</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>&copy; 2026 AR Vending Solutions. All rights reserved.</p>
        </div>
    </div>
</body>
</html>